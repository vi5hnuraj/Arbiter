JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here
PORT=5550

RELAYER_PRIVATE_KEY=your_relayer_private_key
TREASURY_PRIVATE_KEY=your_treasury_private_key

# Arc Testnet Configuration (Circle L1 with USDC Native Gas)
NETWORK=arc-testnet
CHAIN_NAME="Arc Testnet"
CHAIN_ID=5042002
ARC_CHAIN_ID=5042002
RPC_URL="https://rpc.testnet.arc.io"
RPC_URLS="https://rpc.testnet.arc.io,https://rpc.blockdaemon.testnet.arc.io,https://rpc.drpc.testnet.arc.io,https://rpc.quicknode.testnet.arc.io"
EXPLORER_URL="https://testnet.arcscan.app/"
SYMBOL="USDC"
GAS_SYMBOL="USDC"
PAYMENT_MODE=USDC
FAUCET_URL="https://faucet.circle.com"

ARBITER_MANAGER_ADDRESS=0x6b5BA9E3E8175eCfB8291FA0ee358b070c0522Cc

# Paxos USDG (Global Dollar) — optional second settlement token for held-mode
# escrows (USDC remains the default). Default below is the verified USDG proxy
# on Arbitrum One; set the address for the ACTIVE testnet network before
# settling in USDG there. The backend verifies the token's on-chain symbol
# before any funds move.
USDG_CONTRACT_ADDRESS=0x004B506865409877C9fA29bfb1ebA929984B9bbC

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_DATABASE_URL=postgresql://postgres:...

# Wallet Configuration
WALLET_PROVIDER=mpc
MPC_SERVICE_URL=http://localhost:8101
MPC_SERVICE_TOKEN=dev-service-token
MPC_RPC_TIMEOUT_MS=20000

# Execution rail: 'arc' (default, local MPC on Arc testnet) | 'keeperhub'
# (delegates settlement to KeeperHub — Turnkey wallet, dry-run, audit trail)
EXECUTION_RAIL=arc
KEEPERHUB_CHAIN_ID=84532
KEEPERHUB_BASE_URL=https://app.keeperhub.com
# Base Sepolia deployment of ArbiterPaymentManager (separate from the Arc one)
KEEPERHUB_MANAGER_ADDRESS=
# Organisation API key from app.keeperhub.com → Settings → Developer → API keys (kh_...)
KEEPERHUB_API_KEY=
# Override only if the probe reports a different positional-args field name:
# KEEPERHUB_MCP_ARG_FIELD=args

NODE_ENV=development
