# Copy to .env and fill in. NEVER commit .env.

# === Wallet ===
# A DEDICATED TESTNET key, not your main wallet.
PRIVATE_KEY=0x...

# Optional second wallet to make the demo look real (consumer != provider)
PROVIDER_ADDRESS=0x...

# === Arbitrum Sepolia (primary network) ===
ARB_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
# Circle native testnet USDC (default in deploy script)
ARB_USDC=0x75faf114eafb1BDbe2F1791fBc7A4D3B3C012C58
# Chainlink USDC/USD feed on Arbitrum Sepolia — verify on data.chain.link before setting.
# Leave empty to use the contract's fixed 1.0 fallback (demo still works).
ARB_PRICE_FEED=
# ETH faucet: https://arbitrum.faucet.dev/  |  https://faucet.quicknode.com/arbitrum/sepolia
# USDC faucet: https://faucet.circle.com/

# === Robinhood Chain testnet (reserved prize slot) ===
RHC_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
# Set after confirming a testnet USDC on Robinhood Chain (check their docs/Discord).
RHC_USDC=
RHC_PRICE_FEED=
# ETH faucet: https://faucet.testnet.chain.robinhood.com/

# === Paxos USDG (judging bonus criterion) — PLATFORM settlement token ===
# The platform settles real escrows in USDC or USDG (Held panel + x402 routes).
# Default below is the verified USDG proxy on Arbitrum One; set the address for
# the ACTIVE testnet network here before settling in USDG on testnet.
# Backend reads USDG_CONTRACT_ADDRESS; scripts read USDG_ADDRESS.
USDG_CONTRACT_ADDRESS=0x004B506865409877C9fA29bfb1ebA929984B9bbC

# === Filled after deploy (deploy script prints these) ===
MANAGER_ADDRESS=
USDC_ADDRESS=

# === USDG demo (Paxos bonus criterion) ===
# USDG (Global Dollar) proxy on Arbitrum One — verified on Arbiscan:
USDG_ADDRESS=0x004B506865409877C9fA29bfb1ebA929984B9bbC
# No USDG/USD Chainlink feed exists on Arbitrum One, so the manager runs its
# fixed 1.0 fallback for USDG (USDG is a $1 stablecoin by design).
# On Robinhood Chain MAINNET a USDG/USD feed exists (Chainlink changelog) —
# verify the address on data.chain.link before setting RHC_MAINNET_PRICE_FEED.

# === MAINNET SAFETY BRAKES ===
# deploy.js refuses to run on Arbitrum One / Robinhood mainnet unless this
# exact line is present (typed confirmation, not a flag you can hit by accident):
MAINNET_CONFIRM=deploy-arbitrumOne
# demo-usdg.js / demo-autoresolve.js ask for this before ANY mainnet tx:
USDG_DEMO_CONFIRM=yes
